# ClaireAI configuration example. Copy to `.env` for local development.
# `.env` is git-ignored; never put real credentials in this repository.
# Secrets, if any are needed later, belong in the OS credential store.

# Brain: a local Ollama daemon serving Qwen. No training and no API key.
# Install Ollama, then: ollama pull qwen3:1.7b && ollama pull qwen2.5-coder:1.5b
CLAIREAI_BRAIN_PROVIDER=ollama
CLAIREAI_BRAIN_MODEL=qwen3:1.7b
CLAIREAI_BRAIN_CODING_MODEL=qwen2.5-coder:1.5b
# Qwen3 hidden reasoning is expensive on CPU. Off is the fast, agent-friendly
# default; set true for deliberately difficult reasoning turns.
CLAIREAI_BRAIN_THINK=false
# CPU tool calls can legitimately take longer than a minute. This is a
# per-request backstop, not a target; a stalled request still fails clearly.
CLAIREAI_BRAIN_TIMEOUT_SECONDS=180
# Loopback only by default. Changing this to a non-loopback http URL is refused.
CLAIREAI_BRAIN_BASE_URL=http://127.0.0.1:11434/api

# Legacy research path only. Not needed for normal use.
# CLAIREAI_MODEL_CHECKPOINT=~/ClaireAI/models/claire-scratch.pt
CLAIREAI_OWNER_NAME=Bikorimana Ange Tresor

# Decoding temperature (0.0-2.0), chosen per phase by the agent loop:
# CLAIREAI_TEMPERATURE_TOOLS while it is still deciding which tool to call
# (repeatability), CLAIREAI_TEMPERATURE once it has real data and is phrasing an
# answer (natural language). Lower both for a steadier assistant, raise them for
# more variety. Do not set either to 0 and expect recovery: at temperature 0 the
# same input yields the same reply, so the one bounded retry cannot help.
CLAIREAI_TEMPERATURE=0.8
CLAIREAI_TEMPERATURE_TOOLS=0.2
CLAIREAI_RESPONSE_STYLE=balanced

# Optional offline speech output; install eSpeak NG separately. Also editable in UI.
CLAIREAI_VOICE_ENABLED=false
CLAIREAI_VOICE_PITCH=50
CLAIREAI_VOICE_RATE=175

# Development only. Unset to use the OS application-data directory
# (Linux: ~/.local/share/ClaireAI, Windows: %LOCALAPPDATA%\ClaireAI\ClaireAI).
# CLAIREAI_DATA_DIR=./runtime-data

CLAIREAI_LOG_LEVEL=INFO

# The only folders the read-only file tools may touch, as a JSON array.
# Empty by default: with no entries, every file tool is refused.
# CLAIREAI_ALLOWED_FOLDERS=["~/Downloads", "~/Documents"]

# Maximum tool steps per request before the task fails (1-24).
CLAIREAI_AGENT_MAX_STEPS=8

# Cap on generated tokens per model call (8-1024). Lower is faster on a CPU.
CLAIREAI_MAX_OUTPUT_TOKENS=128

# Offer the model only the tools its request can reach (auto), or all of them (off).
# Routing changes which schemas are sent, never which actions are permitted.
CLAIREAI_TOOL_ROUTING=auto

# Presence renderer (desktop HUD/avatar): off | auto | 2d | webgl.
# `auto` uses WebGL only when the webview supports it and holds the frame budget.
CLAIREAI_PRESENCE_MODE=auto
# Frame cap, 5-60. Keep 30 on integrated graphics.
CLAIREAI_PRESENCE_FPS_CAP=30
# Force reduced motion (also follows the OS preference when false).
CLAIREAI_PRESENCE_REDUCE_MOTION=false

# Machine capabilities: screen, camera, cursor, keyboard, clipboard. Empty by
# default; every use still needs approval. `computer_control` is registered only
# when cursor or keyboard is enabled. Browser tools use their own switch.
# CLAIREAI_ALLOWED_CAPABILITIES=["screen", "cursor", "keyboard"]
# Camera index for a future camera_snapshot (0 = first device).
CLAIREAI_CAMERA_DEVICE=0

# Local semantic memory. Text and vectors stay in SQLite. `ollama` uses
# nomic-embed-text; `hash` is an explicit lexical fallback for offline tests.
CLAIREAI_MEMORY_ENABLED=true
# Off by default; each completed turn is then embedded locally as a turn entry.
CLAIREAI_MEMORY_AUTO_EMBED=false
CLAIREAI_EMBEDDING_PROVIDER=ollama
CLAIREAI_EMBEDDING_MODEL=nomic-embed-text

# Optional wake-word engine. `stt` hears the owner's real "Hey Claire" with the
# local faster-whisper model; `openwakeword` uses a trained ONNX model such as
# `hey_jarvis`, which cannot hear an arbitrary phrase. The Tk Voice page can
# start/stop it and persists the choice here.
CLAIREAI_WAKEWORD_ENABLED=false
CLAIREAI_WAKEWORD_ENGINE=stt
CLAIREAI_WAKEWORD_PHRASE=hey claire
CLAIREAI_WAKEWORD_MODEL=hey_jarvis
CLAIREAI_WAKEWORD_THRESHOLD=0.5

# Opt-in FastAPI service. It binds loopback and needs a bearer token; the token
# is read from this variable or a 0600 api.token file in the data directory.
# CLAIREAI_API_HOST=127.0.0.1
# CLAIREAI_API_PORT=8765
# CLAIREAI_API_TOKEN="generate-one-with-secrets.token_urlsafe(32)"
