# ClaireAI configuration example. Copy to `.env` for local development.
# `.env` is git-ignored; never put real credentials in this repository.
# Secrets, if any are needed later, belong in the OS credential store.

# Locally trained from-scratch model, defaulting to <data-dir>/models/claire-scratch.pt.
# Train from your licensed corpus using brain-lab/train.py before chatting.
# CLAIREAI_MODEL_CHECKPOINT=~/ClaireAI/models/claire-scratch.pt
CLAIREAI_OWNER_NAME=Bikorimana Ange Tresor

# Decoding temperature (0.0-2.0), chosen per phase by the agent loop:
# CLAIREAI_TEMPERATURE_TOOLS while it is still deciding which tool to call
# (repeatability), CLAIREAI_TEMPERATURE once it has real data and is phrasing an
# answer (natural language). Lower both for a steadier assistant, raise them for
# more variety. Do not set either to 0 and expect recovery: at temperature 0 the
# same input yields the same reply, so the one bounded retry cannot help.
CLAIREAI_TEMPERATURE=0.8
CLAIREAI_TEMPERATURE_TOOLS=0.2
CLAIREAI_RESPONSE_STYLE=balanced

# Optional offline speech output; install eSpeak NG separately. Also editable in UI.
CLAIREAI_VOICE_ENABLED=false
CLAIREAI_VOICE_PITCH=50
CLAIREAI_VOICE_RATE=175

# Development only. Unset to use the OS application-data directory
# (Linux: ~/.local/share/ClaireAI, Windows: %LOCALAPPDATA%\ClaireAI\ClaireAI).
# CLAIREAI_DATA_DIR=./runtime-data

CLAIREAI_LOG_LEVEL=INFO

# The only folders the read-only file tools may touch, as a JSON array.
# Empty by default: with no entries, every file tool is refused.
# CLAIREAI_ALLOWED_FOLDERS=["~/Downloads", "~/Documents"]

# Maximum tool steps per request before the task fails (1-24).
CLAIREAI_AGENT_MAX_STEPS=8

# Cap on generated tokens per model call (8-1024). Lower is faster on a CPU.
CLAIREAI_MAX_OUTPUT_TOKENS=128

# Offer the model only the tools its request can reach (auto), or all of them (off).
# Routing changes which schemas are sent, never which actions are permitted.
CLAIREAI_TOOL_ROUTING=auto

# Presence renderer (desktop HUD/avatar): off | auto | 2d | webgl.
# `auto` uses WebGL only when the webview supports it and holds the frame budget.
CLAIREAI_PRESENCE_MODE=auto
# Frame cap, 5-60. Keep 30 on integrated graphics.
CLAIREAI_PRESENCE_FPS_CAP=30
# Force reduced motion (also follows the OS preference when false).
CLAIREAI_PRESENCE_REDUCE_MOTION=false

# Capabilities allowed at runtime: browser, screen, camera, cursor, keyboard,
# clipboard. Empty by default. Browser web access also needs normal tool approval.
# CLAIREAI_ALLOWED_CAPABILITIES=["browser"]
# Camera index for camera_snapshot (0 = first device).
CLAIREAI_CAMERA_DEVICE=0
