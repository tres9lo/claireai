# ClaireAI configuration example. Copy to `.env` for local development.
# `.env` is git-ignored; never put real credentials in this repository.
# Secrets, if any are needed later, belong in the OS credential store.

# Local model runtime. Loopback only unless you deliberately opt out.
CLAIREAI_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model tag to use. Verify it exists locally with `ollama list` before relying on it.
CLAIREAI_OLLAMA_MODEL=qwen2.5:1.5b

# Generation timeout in seconds (1-600).
CLAIREAI_OLLAMA_TIMEOUT_SECONDS=120

# Leave false. Turning this on points the assistant at a non-loopback model host.
CLAIREAI_ALLOW_NON_LOOPBACK_OLLAMA=false

# Development only. Unset to use the OS application-data directory
# (Linux: ~/.local/share/ClaireAI, Windows: %LOCALAPPDATA%\ClaireAI\ClaireAI).
# CLAIREAI_DATA_DIR=./runtime-data

CLAIREAI_LOG_LEVEL=INFO

# The only folders the read-only file tools may touch, as a JSON array.
# Empty by default: with no entries, every file tool is refused.
# CLAIREAI_ALLOWED_FOLDERS=["~/Downloads", "~/Documents"]

# Maximum tool steps per request before the task fails (1-24).
CLAIREAI_AGENT_MAX_STEPS=8

# Cap on generated tokens per model call (32-4096). Lower is faster on a CPU.
CLAIREAI_MAX_OUTPUT_TOKENS=400

# Offer the model only the tools its request can reach (auto), or all of them (off).
# Routing changes which schemas are sent, never which actions are permitted.
CLAIREAI_TOOL_ROUTING=auto

# Presence renderer (desktop HUD/avatar): off | auto | 2d | webgl.
# `auto` uses WebGL only when the webview supports it and holds the frame budget.
CLAIREAI_PRESENCE_MODE=auto
# Frame cap, 5-60. Keep 30 on integrated graphics.
CLAIREAI_PRESENCE_FPS_CAP=30
# Force reduced motion (also follows the OS preference when false).
CLAIREAI_PRESENCE_REDUCE_MOTION=false

# Machine access the assistant may use at all: screen, camera, cursor, keyboard,
# clipboard. Empty by default = every machine-access tool is refused.
# CLAIREAI_ALLOWED_CAPABILITIES=["screen", "camera"]
# Camera index for camera_snapshot (0 = first device).
CLAIREAI_CAMERA_DEVICE=0
